# Caddy reverse proxy for ML UV Unwrap backend (automatic HTTPS).
# Replace uvunwrap.example.com with your domain (e.g. a free duckdns.org subdomain).
uvunwrap.example.com {
    reverse_proxy 127.0.0.1:8000

    # Allow large mesh uploads
    request_body {
        max_size 100MB
    }

    encode zstd gzip

    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }
}
